# Скопируй в .env и заполни своими значениями.
# Сам .env в git не попадает — там токены.

# Подключение также меняется в /настройки: openai (по умолчанию) | qoder.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# auto|none|low|medium|high|xhigh|max|ultracode
LLM_REASONING_EFFORT=auto
# 0 = не передавать --context-window
LLM_CONTEXT_WINDOW=0

# 1 = фейковый LLM (без ключа, для отладки и тестов)
LLM_MOCK=0
# 1 = фейковые эмбеддинги: поиск по конспектам почти не работает,
# только для тестов. Настоящая модель (EMBED_MODEL) скачается при первом запуске.
EMBED_MOCK=0

# распознавание фото и сканов PDF; без него фото не индексируются
OCR_ENABLED=1
# easyocr (локально) | vision (Cloudflare VISION_* ниже) | llm (выбранный API и Vision-модель)
TRANSCRIBE_BACKEND=easyocr
# при лимите LLM-OCR дочитывать фото локальным EasyOCR
OCR_FALLBACK_EASYOCR=1
# отдельная vision-модель; пусто = как LLM_*
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=

# max | tg
MESSENGER=max

# polling (по умолчанию: бот сам забирает обновления, сервер не нужен)
# webhook (обновления приходят POST-ом на /webhook — нужен WEBHOOK_SECRET)
UPDATES_MODE=polling
# секрет вебхука: MAX — заголовок X-Max-Bot-Api-Secret,
# Telegram — X-Telegram-Bot-Api-Secret-Token. Без него вебхук отклоняется.
WEBHOOK_SECRET=
# где слушает HTTP-сервер (main.py). 0.0.0.0 — только за reverse-proxy с HTTPS
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# Администратор мини-приложения. Пусто = спросить ID при первом запуске в терминале.
# Свой ID показывает команда /id в MAX; выбор сохраняется в DATA_DIR/admin.json.
MAX_ADMIN_ID=
# Имя бота без @ — заполнять только после подключения мини-приложения в MAX.
# Для локального хакатона оставить пустым: кнопка open_app пока скрыта.
MAX_WEBAPP_BOT=
# Срок действия подписанных данных входа MAX, секунды.
MAX_INIT_DATA_TTL=3600
# MAX_LOCAL_MINIAPP=1 задаёт start-miniapp-local.cmd: доступ по случайной локальной
# ссылке только с этого компьютера. В обычном запуске этот режим выключен.

# MAX Bot API. Токен храним в отдельном файле max_token.txt (он в .gitignore),
# а не в .env. Переменная MAX_BOT_TOKEN — запасной вариант.
MAX_TOKEN_FILE=max_token.txt
MAX_BOT_ENABLED=1
MAX_BOT_TOKEN=
# лимит размера скачиваемого файла, МБ
MAX_DOWNLOAD_MB=50

# Telegram Bot API (для отладки)
TG_BOT_TOKEN=
TG_PROXY=

# папка с базой и индексом; относительный путь — от папки проекта
DATA_DIR=data

# show | hide — показывать ли размышления в консоли
MAXIMKA_REASONING=show
